rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isVerifiedEmail() && request.auth.token.email == 'schaum@mju.ac.kr';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedEmail() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isApprovedMember() {
      return isAdmin() || (
        isVerifiedEmail() &&
        exists(/databases/$(database)/documents/membersPublic/$(request.auth.uid))
      );
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid', 'email', 'displayName', 'cohort', 'program',
          'academicStatus', 'studentId', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'email', 'displayName', 'cohort', 'program',
          'academicStatus', 'studentId', 'researchInterest', 'applicationNote',
          'status', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
        data.cohort is string && data.cohort.size() >= 1 && data.cohort.size() <= 40 &&
        data.program in ['석사과정', '박사과정', '석박사통합과정'] &&
        data.academicStatus in ['재학', '수료', '졸업'] &&
        data.studentId is string && data.studentId.size() >= 1 && data.studentId.size() <= 30 &&
        (!('researchInterest' in data) || (data.researchInterest is string && data.researchInterest.size() <= 200)) &&
        (!('applicationNote' in data) || (data.applicationNote is string && data.applicationNote.size() <= 400)) &&
        data.status in ['pending', 'approved', 'rejected', 'suspended'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMemberPublic(data) {
      return data.keys().hasAll([
          'uid', 'displayName', 'cohort', 'program', 'academicStatus', 'roleTitle', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'displayName', 'cohort', 'program', 'academicStatus',
          'researchInterest', 'roleTitle', 'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
        data.cohort is string && data.cohort.size() >= 1 && data.cohort.size() <= 40 &&
        data.program in ['석사과정', '박사과정', '석박사통합과정'] &&
        data.academicStatus in ['재학', '수료', '졸업'] &&
        (!('researchInterest' in data) || (data.researchInterest is string && data.researchInterest.size() <= 200)) &&
        data.roleTitle is string && data.roleTitle.size() >= 1 && data.roleTitle.size() <= 60 &&
        data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'grantedBy', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'grantedBy', 'createdAt']) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
        isValidId(data.grantedBy) &&
        data.createdAt is timestamp;
    }

    function isValidPublicSettings(data) {
      return data.keys().hasAll(['councilName', 'semesterLabel', 'welcomeHeadline', 'welcomeSummary', 'updatedAt']) &&
        data.keys().hasOnly(['councilName', 'semesterLabel', 'welcomeHeadline', 'welcomeSummary', 'executiveNotice', 'departmentIntro', 'coverImageUrl', 'updatedAt']) &&
        data.councilName is string && data.councilName.size() >= 1 && data.councilName.size() <= 100 &&
        data.semesterLabel is string && data.semesterLabel.size() >= 1 && data.semesterLabel.size() <= 60 &&
        data.welcomeHeadline is string && data.welcomeHeadline.size() >= 1 && data.welcomeHeadline.size() <= 140 &&
        data.welcomeSummary is string && data.welcomeSummary.size() >= 1 && data.welcomeSummary.size() <= 1200 &&
        (!('executiveNotice' in data) || (data.executiveNotice is string && data.executiveNotice.size() <= 600)) &&
        (!('departmentIntro' in data) || (data.departmentIntro is string && data.departmentIntro.size() <= 2000)) &&
        (!('coverImageUrl' in data) || (data.coverImageUrl is string && data.coverImageUrl.size() <= 500)) &&
        data.updatedAt is timestamp;
    }

    function isValidCommunityLinks(data) {
      return data.keys().hasAll(['mainChatTitle', 'mainChatUrl', 'updatedAt']) &&
        data.keys().hasOnly([
          'mainChatTitle', 'mainChatUrl', 'mainChatPasscode',
          'studyChatTitle', 'studyChatUrl', 'roomRules', 'updatedAt'
        ]) &&
        data.mainChatTitle is string && data.mainChatTitle.size() >= 1 && data.mainChatTitle.size() <= 100 &&
        data.mainChatUrl is string && data.mainChatUrl.size() >= 1 && data.mainChatUrl.size() <= 400 &&
        (!('mainChatPasscode' in data) || (data.mainChatPasscode is string && data.mainChatPasscode.size() <= 40)) &&
        (!('studyChatTitle' in data) || (data.studyChatTitle is string && data.studyChatTitle.size() <= 100)) &&
        (!('studyChatUrl' in data) || (data.studyChatUrl is string && data.studyChatUrl.size() <= 400)) &&
        (!('roomRules' in data) || (data.roomRules is string && data.roomRules.size() <= 1000)) &&
        data.updatedAt is timestamp;
    }

    function isValidActivity(data) {
      return data.keys().hasAll([
          'title', 'category', 'eventDate', 'location', 'summary', 'content',
          'isPublished', 'authorUid', 'authorName', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'title', 'category', 'eventDate', 'location', 'summary', 'content',
          'imageUrl', 'isPublished', 'authorUid', 'authorName', 'createdAt', 'updatedAt'
        ]) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
        data.category in ['학술·세미나', '원우 교류', '현장 탐방', '공지사항'] &&
        data.eventDate is string && data.eventDate.size() >= 1 && data.eventDate.size() <= 40 &&
        data.location is string && data.location.size() >= 1 && data.location.size() <= 120 &&
        data.summary is string && data.summary.size() >= 2 && data.summary.size() <= 300 &&
        data.content is string && data.content.size() >= 2 && data.content.size() <= 6000 &&
        (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 400)) &&
        data.isPublished is bool &&
        isValidId(data.authorUid) &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 60 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidBoardPost(data) {
      return data.keys().hasAll([
          'title', 'category', 'content', 'isPinned', 'recruitStatus',
          'authorUid', 'authorName', 'authorCohort', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'title', 'category', 'content', 'isPinned', 'recruitStatus', 'studySchedule',
          'authorUid', 'authorName', 'authorCohort', 'createdAt', 'updatedAt'
        ]) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
        data.category in ['공지사항', '스터디 모집', '학사·논문 Q&A', '자유게시판'] &&
        data.content is string && data.content.size() >= 2 && data.content.size() <= 10000 &&
        data.isPinned is bool &&
        data.recruitStatus in ['모집중', '마감', '해당없음'] &&
        (!('studySchedule' in data) || (data.studySchedule is string && data.studySchedule.size() <= 120)) &&
        isValidId(data.authorUid) &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 60 &&
        data.authorCohort is string && data.authorCohort.size() >= 1 && data.authorCohort.size() <= 40 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidBoardComment(data) {
      return data.keys().hasAll(['postId', 'authorUid', 'authorName', 'authorCohort', 'content', 'createdAt']) &&
        data.keys().hasOnly(['postId', 'authorUid', 'authorName', 'authorCohort', 'content', 'createdAt']) &&
        isValidId(data.postId) &&
        isValidId(data.authorUid) &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 60 &&
        data.authorCohort is string && data.authorCohort.size() >= 1 && data.authorCohort.size() <= 40 &&
        data.content is string && data.content.size() >= 1 && data.content.size() <= 1500 &&
        data.createdAt is timestamp;
    }

    function isValidResearchTrend(data) {
      return data.keys().hasAll([
          'title', 'category', 'source', 'publishedPeriod', 'summary',
          'isPinned', 'authorUid', 'authorName', 'authorCohort', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'title', 'category', 'source', 'publishedPeriod', 'externalUrl',
          'summary', 'keyTakeaway', 'isPinned', 'authorUid', 'authorName',
          'authorCohort', 'createdAt', 'updatedAt'
        ]) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 150 &&
        data.category in [
          '청소년정책·제도', '상담·심리지원', '디지털·미디어',
          '진로·자립지원', '학술논문·방법론', '학회·공모전'
        ] &&
        data.source is string && data.source.size() >= 1 && data.source.size() <= 100 &&
        data.publishedPeriod is string && data.publishedPeriod.size() >= 1 && data.publishedPeriod.size() <= 30 &&
        (!('externalUrl' in data) || (data.externalUrl is string && data.externalUrl.size() <= 500)) &&
        data.summary is string && data.summary.size() >= 5 && data.summary.size() <= 5000 &&
        (!('keyTakeaway' in data) || (data.keyTakeaway is string && data.keyTakeaway.size() <= 500)) &&
        data.isPinned is bool &&
        isValidId(data.authorUid) &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 60 &&
        data.authorCohort is string && data.authorCohort.size() >= 1 && data.authorCohort.size() <= 40 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidResearchComment(data) {
      return data.keys().hasAll(['trendId', 'authorUid', 'authorName', 'authorCohort', 'content', 'createdAt']) &&
        data.keys().hasOnly(['trendId', 'authorUid', 'authorName', 'authorCohort', 'content', 'createdAt']) &&
        isValidId(data.trendId) &&
        isValidId(data.authorUid) &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 60 &&
        data.authorCohort is string && data.authorCohort.size() >= 1 && data.authorCohort.size() <= 40 &&
        data.content is string && data.content.size() >= 1 && data.content.size() <= 1500 &&
        data.createdAt is timestamp;
    }

    function isValidBookmark(data) {
      return data.keys().hasAll(['trendId', 'title', 'createdAt']) &&
        data.keys().hasOnly(['trendId', 'title', 'createdAt']) &&
        isValidId(data.trendId) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
        data.createdAt is timestamp;
    }

    function isValidResearchSync(data) {
      return data.keys().hasAll([
          'autoEnabled', 'intervalDays', 'lastSyncStatus', 'lastSyncCount',
          'updatedByUid', 'updatedByName', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'autoEnabled', 'intervalDays', 'lastSyncedAt', 'nextSyncAt',
          'lastSyncStatus', 'lastSyncMode', 'lastSyncCount', 'lastSyncMessage',
          'windowLabel', 'scheduleCron', 'timezone', 'koreanCoverageNotice',
          'updatedByUid', 'updatedByName', 'updatedAt'
        ]) &&
        data.autoEnabled is bool &&
        data.intervalDays is int && data.intervalDays >= 1 && data.intervalDays <= 90 &&
        (!('lastSyncedAt' in data) || data.lastSyncedAt is timestamp) &&
        (!('nextSyncAt' in data) || data.nextSyncAt is timestamp) &&
        data.lastSyncStatus in ['idle', 'syncing', 'success', 'error'] &&
        (!('lastSyncMode' in data) || data.lastSyncMode in ['initial_1y', 'biweekly', 'monthly', 'manual']) &&
        data.lastSyncCount is int && data.lastSyncCount >= 0 && data.lastSyncCount <= 500 &&
        (!('lastSyncMessage' in data) || (data.lastSyncMessage is string && data.lastSyncMessage.size() <= 400)) &&
        (!('windowLabel' in data) || (data.windowLabel is string && data.windowLabel.size() <= 80)) &&
        (!('scheduleCron' in data) || (data.scheduleCron is string && data.scheduleCron.size() <= 40)) &&
        (!('timezone' in data) || (data.timezone is string && data.timezone.size() <= 40)) &&
        (!('koreanCoverageNotice' in data) || (data.koreanCoverageNotice is string && data.koreanCoverageNotice.size() <= 400)) &&
        isValidId(data.updatedByUid) &&
        data.updatedByName is string && data.updatedByName.size() >= 1 && data.updatedByName.size() <= 60 &&
        data.updatedAt is timestamp;
    }

    function isValidStringArray(arr, maxLen) {
      return arr is list && arr.size() <= maxLen && (arr.size() == 0 || (arr[0] is string && arr[0].size() <= 300));
    }

    function isValidPaper(data) {
      return data.keys().hasAll([
          'paperId', 'title', 'authors', 'journalName', 'publicationDate', 'language',
          'region', 'abstract', 'keywords', 'source', 'openAccess', 'mainCategory',
          'relatedCategories', 'analysisBasis', 'analysisStatus', 'isPublished',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'paperId', 'title', 'authors', 'journalName', 'publicationDate', 'language',
          'region', 'abstract', 'keywords', 'doi', 'openAlexId', 'crossrefId',
          'paperUrl', 'source', 'openAccess', 'citedByCount', 'mainCategory',
          'relatedCategories', 'researchPurpose', 'researchBackground', 'researchQuestion',
          'researchMethod', 'researchTarget', 'researchFindings', 'researchLimitations',
          'practicalImplications', 'policyImplications', 'easySummary', 'analysisBasis',
          'analysisStatus', 'analysisError', 'isPublished', 'aiAnalysisDate',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.paperId) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 300 &&
        isValidStringArray(data.authors, 30) &&
        data.journalName is string && data.journalName.size() >= 1 && data.journalName.size() <= 200 &&
        data.publicationDate is string && data.publicationDate.size() >= 4 && data.publicationDate.size() <= 20 &&
        data.language is string && data.language.size() >= 1 && data.language.size() <= 20 &&
        data.region in ['domestic', 'international'] &&
        data.abstract is string && data.abstract.size() <= 8000 &&
        isValidStringArray(data.keywords, 20) &&
        (!('doi' in data) || (data.doi is string && data.doi.size() <= 200)) &&
        (!('openAlexId' in data) || (data.openAlexId is string && data.openAlexId.size() <= 160)) &&
        (!('crossrefId' in data) || (data.crossrefId is string && data.crossrefId.size() <= 200)) &&
        (!('paperUrl' in data) || (data.paperUrl is string && data.paperUrl.size() <= 500)) &&
        data.source is string && data.source.size() >= 1 && data.source.size() <= 60 &&
        data.openAccess is bool &&
        (!('citedByCount' in data) || (data.citedByCount is int && data.citedByCount >= 0 && data.citedByCount <= 1000000)) &&
        data.mainCategory in [
          '청소년지도 및 청소년 활동',
          '청소년 진로 및 리더십',
          '청소년 참여 및 사회적 성장',
          'AI 및 디지털 시대의 청소년',
          '청소년 교육 및 평생학습',
          '청소년 문제 및 사회 변화'
        ] &&
        isValidStringArray(data.relatedCategories, 6) &&
        (!('researchPurpose' in data) || (data.researchPurpose is string && data.researchPurpose.size() <= 1500)) &&
        (!('researchBackground' in data) || (data.researchBackground is string && data.researchBackground.size() <= 1500)) &&
        (!('researchQuestion' in data) || (data.researchQuestion is string && data.researchQuestion.size() <= 1000)) &&
        (!('researchMethod' in data) || (data.researchMethod is string && data.researchMethod.size() <= 1500)) &&
        (!('researchTarget' in data) || (data.researchTarget is string && data.researchTarget.size() <= 1000)) &&
        (!('researchFindings' in data) || (data.researchFindings is string && data.researchFindings.size() <= 2500)) &&
        (!('researchLimitations' in data) || (data.researchLimitations is string && data.researchLimitations.size() <= 1500)) &&
        (!('practicalImplications' in data) || (data.practicalImplications is string && data.practicalImplications.size() <= 2000)) &&
        (!('policyImplications' in data) || (data.policyImplications is string && data.policyImplications.size() <= 2000)) &&
        (!('easySummary' in data) || (data.easySummary is string && data.easySummary.size() <= 2500)) &&
        data.analysisBasis is string && data.analysisBasis.size() >= 1 && data.analysisBasis.size() <= 100 &&
        data.analysisStatus in ['completed', 'failed', 'pending'] &&
        (!('analysisError' in data) || (data.analysisError is string && data.analysisError.size() <= 500)) &&
        data.isPublished is bool &&
        (!('aiAnalysisDate' in data) || (data.aiAnalysisDate is string && data.aiAnalysisDate.size() <= 40)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMonthlyReport(data) {
      return data.keys().hasAll([
          'reportId', 'monthLabel', 'periodRange', 'totalPapersCount', 'newPapersCount',
          'domesticCount', 'internationalCount', 'categoryFlows', 'notablePapers',
          'keyThemes', 'commonFindings', 'researchGaps', 'fieldImplications',
          'isPublished', 'createdByUid', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'reportId', 'monthLabel', 'periodRange', 'totalPapersCount', 'newPapersCount',
          'domesticCount', 'internationalCount', 'categoryFlows', 'notablePapers',
          'keyThemes', 'commonFindings', 'researchGaps', 'fieldImplications',
          'isPublished', 'createdByUid', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.reportId) &&
        data.monthLabel is string && data.monthLabel.size() >= 1 && data.monthLabel.size() <= 60 &&
        data.periodRange is string && data.periodRange.size() >= 1 && data.periodRange.size() <= 80 &&
        data.totalPapersCount is int && data.totalPapersCount >= 0 && data.totalPapersCount <= 100000 &&
        data.newPapersCount is int && data.newPapersCount >= 0 && data.newPapersCount <= 100000 &&
        data.domesticCount is int && data.domesticCount >= 0 && data.domesticCount <= 100000 &&
        data.internationalCount is int && data.internationalCount >= 0 && data.internationalCount <= 100000 &&
        data.categoryFlows is string && data.categoryFlows.size() >= 1 && data.categoryFlows.size() <= 4000 &&
        data.notablePapers is string && data.notablePapers.size() >= 1 && data.notablePapers.size() <= 3000 &&
        data.keyThemes is string && data.keyThemes.size() >= 1 && data.keyThemes.size() <= 2500 &&
        data.commonFindings is string && data.commonFindings.size() >= 1 && data.commonFindings.size() <= 2500 &&
        data.researchGaps is string && data.researchGaps.size() >= 1 && data.researchGaps.size() <= 2500 &&
        data.fieldImplications is string && data.fieldImplications.size() >= 1 && data.fieldImplications.size() <= 2500 &&
        data.isPublished is bool &&
        isValidId(data.createdByUid) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSyncLog(data) {
      return data.keys().hasAll([
          'logId', 'triggerType', 'status', 'collectedCount', 'newPapersCount',
          'domesticCount', 'internationalCount', 'analyzedSuccessCount', 'analyzedFailedCount',
          'openAlexCalls', 'crossrefCalls', 'geminiCalls', 'estimatedTokens',
          'collectionErrors', 'analysisErrors', 'executedByUid', 'executedByName', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'logId', 'triggerType', 'status', 'collectedCount', 'newPapersCount',
          'domesticCount', 'internationalCount', 'analyzedSuccessCount', 'analyzedFailedCount',
          'openAlexCalls', 'crossrefCalls', 'geminiCalls', 'estimatedTokens',
          'collectionErrors', 'analysisErrors', 'koreanCoverageNotice',
          'executedByUid', 'executedByName', 'createdAt'
        ]) &&
        isValidId(data.logId) &&
        data.triggerType in ['manual', 'scheduled_monthly', 'retry_failed'] &&
        data.status in ['success', 'partial', 'error'] &&
        data.collectedCount is int && data.collectedCount >= 0 && data.collectedCount <= 10000 &&
        data.newPapersCount is int && data.newPapersCount >= 0 && data.newPapersCount <= 10000 &&
        data.domesticCount is int && data.domesticCount >= 0 && data.domesticCount <= 10000 &&
        data.internationalCount is int && data.internationalCount >= 0 && data.internationalCount <= 10000 &&
        data.analyzedSuccessCount is int && data.analyzedSuccessCount >= 0 && data.analyzedSuccessCount <= 10000 &&
        data.analyzedFailedCount is int && data.analyzedFailedCount >= 0 && data.analyzedFailedCount <= 10000 &&
        data.openAlexCalls is int && data.openAlexCalls >= 0 && data.openAlexCalls <= 10000 &&
        data.crossrefCalls is int && data.crossrefCalls >= 0 && data.crossrefCalls <= 10000 &&
        data.geminiCalls is int && data.geminiCalls >= 0 && data.geminiCalls <= 10000 &&
        data.estimatedTokens is int && data.estimatedTokens >= 0 && data.estimatedTokens <= 100000000 &&
        isValidStringArray(data.collectionErrors, 30) &&
        isValidStringArray(data.analysisErrors, 30) &&
        (!('koreanCoverageNotice' in data) || (data.koreanCoverageNotice is string && data.koreanCoverageNotice.size() <= 400)) &&
        isValidId(data.executedByUid) &&
        data.executedByName is string && data.executedByName.size() >= 1 && data.executedByName.size() <= 60 &&
        data.createdAt is timestamp;
    }

    match /test/connection {
      allow get: if true;
      allow write: if false;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);

      allow create: if isValidId(userId) &&
        isVerifiedEmail() &&
        isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == userId &&
        incoming().email == request.auth.token.email &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (isAdmin() || incoming().status == 'pending');

      allow update: if isValidId(userId) &&
        isVerifiedEmail() &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() || (
            isOwner(userId) &&
            incoming().status == existing().status &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'cohort', 'program', 'academicStatus',
              'studentId', 'researchInterest', 'applicationNote', 'updatedAt'
            ])
          )
        );

      allow delete: if isValidId(userId) && isAdmin();

      match /bookmarks/{trendId} {
        allow get: if isValidId(userId) && isValidId(trendId) && isOwner(userId) && isApprovedMember();
        allow list: if isValidId(userId) && isOwner(userId) && isApprovedMember();
        allow create: if isValidId(userId) && isValidId(trendId) &&
          isOwner(userId) && isApprovedMember() &&
          isValidBookmark(incoming()) &&
          incoming().trendId == trendId &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/researchTrends/$(trendId));
        allow delete: if isValidId(userId) && isValidId(trendId) && isOwner(userId) && isApprovedMember();
      }
    }

    match /membersPublic/{memberId} {
      allow get: if isValidId(memberId) && isApprovedMember();
      allow list: if isApprovedMember();

      allow create: if isValidId(memberId) &&
        isAdmin() &&
        isValidMemberPublic(incoming()) &&
        incoming().uid == memberId &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(memberId) &&
        isValidMemberPublic(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().updatedAt == request.time && (
          isAdmin() || (
            isOwner(memberId) &&
            isApprovedMember() &&
            incoming().roleTitle == existing().roleTitle &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'cohort', 'program', 'academicStatus',
              'researchInterest', 'updatedAt'
            ])
          )
        );

      allow delete: if isValidId(memberId) && isAdmin();
    }

    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(adminId) &&
        isAdmin() &&
        isValidAdminRecord(incoming()) &&
        incoming().uid == adminId &&
        incoming().grantedBy == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(adminId) && isAdmin();
    }

    match /settings/public {
      allow get: if true;
      allow create, update: if isAdmin() &&
        isValidPublicSettings(incoming()) &&
        incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /settings/communityLinks {
      allow get: if isApprovedMember();
      allow create, update: if isAdmin() &&
        isValidCommunityLinks(incoming()) &&
        incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /settings/researchSync {
      allow get: if true;
      allow create, update: if isAdmin() &&
        isValidResearchSync(incoming()) &&
        incoming().updatedByUid == request.auth.uid &&
        incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /papers/{paperId} {
      allow get: if isValidId(paperId) && ((resource != null && existing().isPublished == true) || isAdmin());
      allow list: if resource.data.isPublished == true || isAdmin();

      allow create: if isValidId(paperId) &&
        isAdmin() &&
        isValidPaper(incoming()) &&
        incoming().paperId == paperId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(paperId) &&
        isAdmin() &&
        isValidPaper(incoming()) &&
        incoming().paperId == existing().paperId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;

      allow delete: if isValidId(paperId) && isAdmin();
    }

    match /monthlyReports/{reportId} {
      allow get: if isValidId(reportId) && ((resource != null && existing().isPublished == true) || isAdmin());
      allow list: if resource.data.isPublished == true || isAdmin();

      allow create: if isValidId(reportId) &&
        isAdmin() &&
        isValidMonthlyReport(incoming()) &&
        incoming().reportId == reportId &&
        incoming().createdByUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(reportId) &&
        isAdmin() &&
        isValidMonthlyReport(incoming()) &&
        incoming().reportId == existing().reportId &&
        incoming().createdByUid == existing().createdByUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;

      allow delete: if isValidId(reportId) && isAdmin();
    }

    match /syncLogs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isAdmin();

      allow create: if isValidId(logId) &&
        isAdmin() &&
        isValidSyncLog(incoming()) &&
        incoming().logId == logId &&
        incoming().executedByUid == request.auth.uid &&
        incoming().createdAt == request.time;

      allow update: if false;
      allow delete: if isValidId(logId) && isAdmin();
    }

    match /activities/{activityId} {
      allow get: if isValidId(activityId) && ((resource != null && existing().isPublished == true) || isAdmin());
      allow list: if resource.data.isPublished == true || isAdmin();

      allow create: if isValidId(activityId) &&
        isAdmin() &&
        isValidActivity(incoming()) &&
        incoming().authorUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(activityId) &&
        isAdmin() &&
        isValidActivity(incoming()) &&
        incoming().authorUid == existing().authorUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;

      allow delete: if isValidId(activityId) && isAdmin();
    }

    match /boardPosts/{postId} {
      allow get: if isValidId(postId) && isApprovedMember();
      allow list: if isApprovedMember();

      allow create: if isValidId(postId) &&
        isApprovedMember() &&
        isValidBoardPost(incoming()) &&
        incoming().authorUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (isAdmin() || incoming().isPinned == false);

      allow update: if isValidId(postId) &&
        isApprovedMember() &&
        isValidBoardPost(incoming()) &&
        incoming().authorUid == existing().authorUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() || (
            existing().authorUid == request.auth.uid &&
            incoming().isPinned == existing().isPinned &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'category', 'content', 'recruitStatus', 'studySchedule', 'updatedAt'
            ])
          )
        );

      allow delete: if isValidId(postId) &&
        isApprovedMember() &&
        (existing().authorUid == request.auth.uid || isAdmin());

      match /comments/{commentId} {
        allow get: if isValidId(postId) && isValidId(commentId) && isApprovedMember();
        allow list: if isValidId(postId) && isApprovedMember();

        allow create: if isValidId(postId) && isValidId(commentId) &&
          isApprovedMember() &&
          exists(/databases/$(database)/documents/boardPosts/$(postId)) &&
          isValidBoardComment(incoming()) &&
          incoming().postId == postId &&
          incoming().authorUid == request.auth.uid &&
          incoming().createdAt == request.time;

        allow update: if isValidId(postId) && isValidId(commentId) &&
          isApprovedMember() &&
          isValidBoardComment(incoming()) &&
          incoming().postId == existing().postId &&
          incoming().authorUid == existing().authorUid &&
          incoming().createdAt == existing().createdAt &&
          (isAdmin() || existing().authorUid == request.auth.uid) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['content']);

        allow delete: if isValidId(postId) && isValidId(commentId) &&
          isApprovedMember() &&
          (existing().authorUid == request.auth.uid || isAdmin());
      }
    }

    match /researchTrends/{trendId} {
      allow get: if isValidId(trendId) && isApprovedMember();
      allow list: if isApprovedMember();

      allow create: if isValidId(trendId) &&
        isApprovedMember() &&
        isValidResearchTrend(incoming()) &&
        incoming().authorUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (isAdmin() || incoming().isPinned == false);

      allow update: if isValidId(trendId) &&
        isApprovedMember() &&
        isValidResearchTrend(incoming()) &&
        incoming().authorUid == existing().authorUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() || (
            existing().authorUid == request.auth.uid &&
            incoming().isPinned == existing().isPinned &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'category', 'source', 'publishedPeriod',
              'externalUrl', 'summary', 'keyTakeaway', 'updatedAt'
            ])
          )
        );

      allow delete: if isValidId(trendId) &&
        isApprovedMember() &&
        (existing().authorUid == request.auth.uid || isAdmin());

      match /comments/{commentId} {
        allow get: if isValidId(trendId) && isValidId(commentId) && isApprovedMember();
        allow list: if isValidId(trendId) && isApprovedMember();

        allow create: if isValidId(trendId) && isValidId(commentId) &&
          isApprovedMember() &&
          exists(/databases/$(database)/documents/researchTrends/$(trendId)) &&
          isValidResearchComment(incoming()) &&
          incoming().trendId == trendId &&
          incoming().authorUid == request.auth.uid &&
          incoming().createdAt == request.time;

        allow update: if isValidId(trendId) && isValidId(commentId) &&
          isApprovedMember() &&
          isValidResearchComment(incoming()) &&
          incoming().trendId == existing().trendId &&
          incoming().authorUid == existing().authorUid &&
          incoming().createdAt == existing().createdAt &&
          (isAdmin() || existing().authorUid == request.auth.uid) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['content']);

        allow delete: if isValidId(trendId) && isValidId(commentId) &&
          isApprovedMember() &&
          (existing().authorUid == request.auth.uid || isAdmin());
      }
    }
  }
}
