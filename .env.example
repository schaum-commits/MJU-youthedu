# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OPENALEX_API_KEY: Optional API key for higher OpenAlex rate limits (server-side only).
OPENALEX_API_KEY=""

# NANET_API_KEY: National Assembly Library Open API serviceKey (data.go.kr, server-side only).
NANET_API_KEY=""
# NANET_API_ENDPOINT: Optional override (defaults to https://apis.data.go.kr/9720000/searchservice/basic).
NANET_API_ENDPOINT=""

# NL_API_KEY: National Library of Korea Open API key (Step 3, server-side only).
NL_API_KEY=""
# NL_API_ENDPOINT: Optional override (defaults to https://www.nl.go.kr/NL/search/openApi/search.do).
NL_API_ENDPOINT=""

# DBPIA_API_KEY: DBpia Open API key (Step 5 - metadata search & link-out only per DBpia terms).
DBPIA_API_KEY=""
# DBPIA_API_ENDPOINT: Optional override (defaults to https://api.dbpia.co.kr/v2/search/search.xml).
DBPIA_API_ENDPOINT=""

# ALLOWED_ORIGINS: Comma-separated CORS allowlist for the Cloud Run API server
# (e.g. "https://<github-user>.github.io,https://your-custom-domain.com").
# When omitted, *.github.io, *.run.app, *.web.app, *.firebaseapp.com, and localhost are allowed by default.
ALLOWED_ORIGINS=""

# VITE_API_BASE_URL: Public Google Cloud Run backend URL embedded into GitHub Pages static builds
# (e.g. "https://mju-youth-api-xxxx-du.a.run.app"). Never put API secrets in VITE_* variables.
VITE_API_BASE_URL=""

